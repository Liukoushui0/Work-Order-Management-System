# ============================================================
# ServiceFlow 本地开发环境变量示例
# 用法：按需在启动前导出这些变量；本文件只包含占位值，
#       请勿把真实密码、令牌或私钥写入任何被 Git 跟踪的文件。
# ============================================================

# ---------- 后端：MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=serviceflow
DB_USERNAME=root
DB_PASSWORD=your-local-db-password

# ---------- 后端：Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- 后端：其他 ----------
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_UPLOAD_DIR=./storage/attachments

# ---------- 前端 ----------
# 开发环境保留 /api/v1，由 Vite 开发服务器代理到后端
VITE_API_BASE_URL=/api/v1
